# --- ARIA SEO site: keep deploy artifacts out of the GitHub Pages repo ---
# Python caches / bytecode
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Build / generator scratch + marker files
*.tmp
*.done
*.bak
*.bak_*
*.repaired.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Local logs
*.log

# --- Credential safety: this repo is PUBLIC. Nothing secret may ever be tracked. ---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.obsidian/
credentials.json
service-account*.json

# --- Local Claude Code settings: machine-specific, never committed. ---
# permissions.defaultMode lives here, NOT in the committed settings.json, so that
# cloning this public repo does not hand a stranger's session bypassPermissions.
.claude/settings.local.json
