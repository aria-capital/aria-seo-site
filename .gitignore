# --- ARIA SEO site: keep deploy artifacts out of the GitHub Pages repo ---
# Python caches / bytecode
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Build / generator scratch + marker files
*.tmp
*.done
*.bak
*.bak_*
*.repaired.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Local logs
*.log

# Claude Code local settings — machine-specific, never published.
# The owner runs with approval prompts disabled on machines he owns. That belongs
# here (localSettings scope, untracked), not in .claude/settings.json, because this
# repo is PUBLIC and a committed defaultMode ships prompt-free Claude to anyone who
# clones it. Ignoring it in-repo matters: the cloud container happens to ignore this
# path via a global gitignore, but a Mac clone does not, so without this line the
# file would be committable there.
.claude/settings.local.json

# Orphans from unclean FUSE unmounts — mid-write snapshots, never content.
# 1,255 were tracked until 2026-08-07; verified first that none held the missing
# text of the three truncated articles, then removed.
.fuse_hidden*
